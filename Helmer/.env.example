# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Next.js env vars (M2 port and later phases) ---

# Mock switch. Set to 0 in B4 when the real backend is wired.
NEXT_PUBLIC_USE_MOCK=0

# Supabase / Postgres (B1+)
DATABASE_URL=postgresql://postgres.<ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<ref>:<password>@<session-pooler-host>:5432/postgres

# LLM (B3+)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Search (B3+)
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=

# App auth (B1+)
ACCESS_CODE=change-me
SECRET_KEY=change-me-too
WORKER_TAG=prod

# Agent budgets (B1+)
MAX_STEPS=8
MAX_SECONDS=180
MAX_LLM_CALLS=25
ALLOW_TAMPER=1
PORT=3000
