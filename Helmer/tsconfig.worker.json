{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": ["worker/**/*.ts", "server/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", ".next", "src", "app", "components", "lib"]
}
